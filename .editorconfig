root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,shader,cginc,py}]
end_of_line = lf
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
